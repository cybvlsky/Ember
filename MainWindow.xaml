<Window x:Class="Ember.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:e="clr-namespace:Ember"
        Title="Ember" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#22201E" Foreground="#EEE8E2" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Bahnschrift, Segoe UI" FontSize="13.5">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Coal and ash: warm graphite surfaces, ember orange only for what is live or selected. -->
    <SolidColorBrush x:Key="Bg" Color="#22201E"/>
    <SolidColorBrush x:Key="Panel" Color="#2A2725"/>
    <SolidColorBrush x:Key="Raised" Color="#34302D"/>
    <SolidColorBrush x:Key="Field" Color="#1B1918"/>
    <SolidColorBrush x:Key="Line" Color="#3A3633"/>
    <SolidColorBrush x:Key="Line2" Color="#4D4743"/>
    <SolidColorBrush x:Key="Text" Color="#EEE8E2"/>
    <SolidColorBrush x:Key="Sub" Color="#A69D94"/>
    <SolidColorBrush x:Key="Dim" Color="#756D66"/>
    <SolidColorBrush x:Key="Ember" Color="#FF6A1F"/>
    <SolidColorBrush x:Key="EmberSoft" Color="#3A2A20"/>
    <FontFamily x:Key="Ico">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Sub}"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#1E1C1A"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="6" Background="#EEE8E2" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#D9D2CB"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ember}"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ember}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Text-only action, for secondary things next to content (Edit, Duplicate). -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Ember}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Palette entry in the editor's Add list: icon and label, no frame until hovered. -->
    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,2,2"><ContentPresenter HorizontalAlignment="Left"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="{StaticResource Ico}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent" Height="48">
          <TextBlock Text="{TemplateBinding Content}" Margin="12,0" VerticalAlignment="Center"/>
          <Border x:Name="bar" Height="2" Margin="12,0,12,7" VerticalAlignment="Bottom" Background="{StaticResource Ember}" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter TargetName="bar" Property="Opacity" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Border x:Name="track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="#3E3935" VerticalAlignment="Center">
            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource Sub}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="track" Property="Background" Value="{StaticResource Ember}"/><Setter TargetName="knob" Property="Fill" Value="#22201E"/>
            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Text}"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Flag" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="b" CornerRadius="5" Background="Transparent" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="9,4"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ember}"/><Setter TargetName="b" Property="Background" Value="{StaticResource EmberSoft}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- One segment of a segmented control; the container draws the outer frame. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="4" Background="Transparent" Padding="10,4" Margin="2"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Line2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="22" Background="Transparent">
          <Border Height="2" Background="{StaticResource Line2}" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" Background="{StaticResource Ember}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Ellipse x:Name="e" Width="14" Height="14" Fill="{StaticResource Text}"/>
                  <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="e" Property="Fill" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="SelectionBrush" Value="{StaticResource Ember}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ember}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="b" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource EmberSoft}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="MaxDropDownHeight" Value="380"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="tb" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ember}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,6,30,6" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="6" Padding="0,4" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{StaticResource Line2}" Margin="2,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{StaticResource Line2}" Margin="2,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="#3A3633" CornerRadius="4" Padding="9,5"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource Bg}" Opacity="0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- title bar: brand, page tabs, page actions, window buttons -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="ember" FontSize="17" FontWeight="SemiBold" Margin="9,-2,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0">
            <RadioButton x:Name="NavScreen" Style="{StaticResource Tab}" Content="{e:Tr Screen}" IsChecked="True" GroupName="nav"/>
            <RadioButton x:Name="NavThemes" Style="{StaticResource Tab}" Content="{e:Tr Themes}" GroupName="nav"/>
            <RadioButton x:Name="NavEditor" Style="{StaticResource Tab}" Content="{e:Tr Editor}" GroupName="nav"/>
            <RadioButton x:Name="NavSensors" Style="{StaticResource Tab}" Content="{e:Tr Sensors}" GroupName="nav"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Tab}" Content="{e:Tr Settings}" GroupName="nav"/>
          </StackPanel>
          <StackPanel x:Name="TopActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{e:Tr 'Close the window. Ember keeps running in the tray.'}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="Pages" Grid.Row="1">

        <!-- ===== Screen ===== -->
        <Grid x:Name="PageScreen">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <Grid ClipToBounds="True">
            <!-- The panel's own light on the desk: a tiny average of the current frame, blown up and blurred. -->
            <Image x:Name="GlowImage" Stretch="Fill" Opacity="0.55" Margin="-60" RenderOptions.BitmapScalingMode="Linear" IsHitTestVisible="False">
              <Image.Effect><BlurEffect Radius="90" KernelType="Gaussian"/></Image.Effect>
              <Image.OpacityMask>
                <RadialGradientBrush><GradientStop Color="#FF000000" Offset="0.25"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush>
              </Image.OpacityMask>
            </Image>
            <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="1040" Margin="40,24,40,64">
              <Border x:Name="Device" Width="540" Height="380" CornerRadius="12" Padding="30" Margin="30" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#191716" Offset="0"/><GradientStop Color="#0C0B0A" Offset="1"/></LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55504B" Offset="0"/><GradientStop Color="#181615" Offset="1"/></LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="46" ShadowDepth="20" Direction="270" Opacity="0.55"/></Border.Effect>
                <Border Background="#000000">
                  <Image x:Name="ScreenImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
              </Border>
            </Viewbox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
              <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Dim}" Margin="0,1,9,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnText" Foreground="{StaticResource Sub}"/>
              <TextBlock x:Name="FpsText" Foreground="{StaticResource Sub}" Margin="28,0,0,0" ToolTip="{e:Tr 'Updates per second that reach the panel'}"/>
              <TextBlock x:Name="BwText" Foreground="{StaticResource Sub}" Margin="28,0,0,0" ToolTip="{e:Tr 'USB link use. The panel takes about 157 KB/s.'}"/>
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="26,24,26,26">
                <Grid>
                  <TextBlock Text="{e:Tr Theme}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrevTheme" Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="{e:Tr Previous}"/>
                    <Button x:Name="NextTheme" Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="{e:Tr Next}"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ThemeName" FontSize="26" FontWeight="Light" Margin="0,4,0,0"/>
                <TextBlock x:Name="ThemeDesc" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                <Button x:Name="BrowseThemes" Style="{StaticResource Link}" Content="{e:Tr 'All themes'}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                <Grid Margin="0,32,0,0">
                  <TextBlock Text="{e:Tr Brightness}" Style="{StaticResource Head}"/>
                  <TextBlock x:Name="BrightText" HorizontalAlignment="Right" Foreground="{StaticResource Sub}"/>
                </Grid>
                <Slider x:Name="BrightSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Margin="0,8,0,0"/>

                <CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}" Margin="0,30,0,0">
                  <StackPanel><TextBlock Text="{e:Tr 'Rotate 180°'}"/><TextBlock Text="{e:Tr 'For when the cable comes out the other side'}" Style="{StaticResource SubText}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="SleepSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Content="{e:Tr 'Sleep with the monitors'}"/>
                <CheckBox x:Name="BlankSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Content="{e:Tr 'Turn the screen off'}"/>

                <TextBlock Text="{e:Tr Sensors}" Style="{StaticResource Head}" Margin="0,34,0,12"/>
                <StackPanel x:Name="SensorStatus"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ===== Themes ===== -->
        <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <WrapPanel x:Name="Gallery" Margin="36,30,8,16"/>
        </ScrollViewer>

        <!-- ===== Editor ===== -->
        <Grid x:Name="PageEditor" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,10,12">
              <TextBlock DockPanel.Dock="Top" Text="{e:Tr Add}" Style="{StaticResource Head}" Margin="4,0,0,8"/>
              <UniformGrid x:Name="AddPanel" DockPanel.Dock="Top" Columns="2" Margin="0,0,0,18"/>
              <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                <TextBlock Text="{e:Tr Layers}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="LayerUp" Style="{StaticResource IconBtn}" Content="&#xE74A;" Width="26" Height="26" FontSize="11" ToolTip="{e:Tr 'Bring forward'}"/>
                  <Button x:Name="LayerDown" Style="{StaticResource IconBtn}" Content="&#xE74B;" Width="26" Height="26" FontSize="11" ToolTip="{e:Tr 'Send backward'}"/>
                  <Button x:Name="LayerDup" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11" ToolTip="{e:Tr 'Duplicate (Ctrl+D)'}"/>
                  <Button x:Name="LayerDel" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="26" Height="26" FontSize="11" ToolTip="{e:Tr 'Delete (Del)'}"/>
                </StackPanel>
              </Grid>
              <ListBox x:Name="Layers" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Sub}"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="b" CornerRadius="4" Background="Transparent" Padding="8,5" Margin="0,0,0,1"><ContentPresenter/></Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource EmberSoft}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </DockPanel>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="36,20,36,0">
              <TextBlock x:Name="EditorName" Style="{StaticResource H2}" VerticalAlignment="Bottom"/>
              <TextBlock x:Name="EditorState" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="12,0,0,1" VerticalAlignment="Bottom"/>
            </StackPanel>
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="36,18,36,12">
              <Border Padding="12" Background="#0C0B0A" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid x:Name="CanvasHost" Width="480" Height="320" ClipToBounds="False" Background="#000000" Cursor="Cross" Focusable="True">
                  <Image x:Name="EditImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <Canvas x:Name="Overlay" Width="480" Height="320" IsHitTestVisible="False"/>
                </Grid>
              </Border>
            </Viewbox>
            <Grid Grid.Row="2" Margin="36,0,36,16">
              <TextBlock x:Name="EditHint" Style="{StaticResource SubText}" FontSize="12" VerticalAlignment="Center"
                         Text="{e:Tr 'Drag to move. Arrows nudge 1 px, Shift+arrows 10 px. Hold Alt to stop snapping.'}"/>
              <TextBlock x:Name="CursorPos" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            </Grid>
          </Grid>

          <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Props" Margin="22,18,20,24"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ===== Sensors ===== -->
        <Grid x:Name="PageSensors" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="36,24,36,8">
            <Grid Width="300" HorizontalAlignment="Left">
              <TextBox x:Name="SensorSearch" Padding="30,6,8,6"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ico}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="{e:Tr Search}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="{e:Tr 'Click a row to copy its key.'}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SensorList" Margin="36,0,36,28"/>
          </ScrollViewer>
        </Grid>

        <!-- ===== Settings ===== -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SettingsPanel" Width="680" HorizontalAlignment="Left" Margin="36,8,36,36"/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
