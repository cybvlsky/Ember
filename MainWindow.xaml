<Window x:Class="Ember.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ember" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0A0D12" Foreground="#E8ECF2" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="Sub" Color="#8A94A6"/>
    <SolidColorBrush x:Key="Dim" Color="#5E697C"/>
    <SolidColorBrush x:Key="Card" Color="#121821"/>
    <SolidColorBrush x:Key="Card2" Color="#151B25"/>
    <SolidColorBrush x:Key="Line" Color="#212A38"/>
    <SolidColorBrush x:Key="Line2" Color="#2C3646"/>
    <SolidColorBrush x:Key="Hover" Color="#1C2330"/>
    <SolidColorBrush x:Key="AccentSolid" Color="#FF9A3D"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFC53D" Offset="0"/><GradientStop Color="#FF6A3D" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Ico">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Dim}"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#1A1208"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="11" Background="{StaticResource Accent}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.Effect><DropShadowEffect Color="#FF7A3D" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.92"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#D5DBE5"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Background="#151B25" BorderBrush="#27303F" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2330"/><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#232B39"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#8A94A6"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{StaticResource Ico}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1F2733"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8A94A6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" Width="64" Height="58" CornerRadius="14" Background="Transparent">
          <Grid>
            <Border x:Name="bar" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left" Margin="-10,0,0,0" Background="{StaticResource Accent}" Opacity="0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Ico}" FontSize="18" HorizontalAlignment="Center"/>
              <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#161C26"/><Setter Property="Foreground" Value="#D5DBE5"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="b" Property="Background" Value="#1D1710"/><Setter Property="Foreground" Value="#FFB347"/><Setter TargetName="bar" Property="Opacity" Value="1"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E8ECF2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#232C3A">
            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#8A94A6" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="knob" Property="Fill" Value="#1A1208"/>
            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Flag" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#C5CCD8"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="b" CornerRadius="8" Background="#151B25" BorderBrush="#27303F" BorderThickness="1" Padding="10,5"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/><Setter TargetName="b" Property="Background" Value="#241A10"/><Setter Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#C5CCD8"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="8" Background="#151B25" BorderBrush="#27303F" BorderThickness="1" Padding="10,5"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/><Setter TargetName="b" Property="Background" Value="#241A10"/><Setter Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="22">
          <Border Height="4" CornerRadius="2" Background="#232C3A" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Ellipse x:Name="e" Width="16" Height="16" Fill="#F4F6FA" Stroke="#FF8A3D" StrokeThickness="3"/>
                  <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="e" Property="Fill" Value="#FFC53D"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#E8ECF2"/><Setter Property="CaretBrush" Value="#FFB347"/><Setter Property="SelectionBrush" Value="#FF9A3D"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="9,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" Background="#0E131A" BorderBrush="#27303F" BorderThickness="1" CornerRadius="9">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#D5DBE5"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="b" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3,1"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#1F2733"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E8ECF2"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="MaxDropDownHeight" Value="380"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="tb" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="#0E131A" BorderBrush="#27303F" BorderThickness="1" CornerRadius="9">
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#8A94A6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,30,6" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#121821" BorderBrush="#2C3646" BorderThickness="1" CornerRadius="10" Padding="0,4" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#2A3445" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#2A3445" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="#E8ECF2"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="#1A212D" BorderBrush="#2C3646" BorderThickness="1" CornerRadius="8" Padding="10,6"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform ScaleX="0.985" ScaleY="0.985"/></Border.RenderTransform>
    <Border.Background>
      <RadialGradientBrush Center="0.92,0.02" GradientOrigin="0.92,0.02" RadiusX="0.6" RadiusY="0.8">
        <GradientStop Color="#2B1B0E" Offset="0"/><GradientStop Color="#0A0D12" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Border BorderBrush="#161C25" BorderThickness="0,0,1,0" Background="#80090C10">
        <DockPanel Margin="12,16,12,14">
          <Image x:Name="Logo" DockPanel.Dock="Top" Width="38" Height="38" Margin="0,0,0,22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#5E697C" HorizontalAlignment="Center" ToolTip="Stan ekranu"/>
            <TextBlock x:Name="VersionText" Text="1.0" FontSize="10" Foreground="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="NavPanel" HorizontalAlignment="Center">
            <RadioButton x:Name="NavScreen" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Ekran" IsChecked="True" GroupName="nav"/>
            <RadioButton x:Name="NavThemes" Style="{StaticResource Nav}" Tag="&#xE790;" Content="Motywy" GroupName="nav"/>
            <RadioButton x:Name="NavEditor" Style="{StaticResource Nav}" Tag="&#xE70F;" Content="Edytor" GroupName="nav"/>
            <RadioButton x:Name="NavSensors" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Czujniki" GroupName="nav"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Ustawienia" GroupName="nav"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- top bar (caption) -->
        <Grid Margin="30,0,10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Ekran" Style="{StaticResource H1}"/>
            <TextBlock x:Name="PageSub" Text="" Style="{StaticResource SubText}" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0">
            <StackPanel x:Name="TopActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MinBtn" Style="{StaticResource IconBtn}" Content="&#xE921;" FontSize="10" Width="46" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimalizuj"/>
            <Button x:Name="MaxBtn" Style="{StaticResource IconBtn}" Content="&#xE922;" FontSize="10" Width="46" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maksymalizuj"/>
            <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" FontSize="10" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Zamknij okno (Ember działa dalej w zasobniku)"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="Pages" Grid.Row="1" Margin="30,0,30,26">

          <!-- ===== Ekran ===== -->
          <Grid x:Name="PageScreen">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,26,0">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="1000">
                <Border x:Name="Device" Width="540" Height="380" CornerRadius="22" Padding="30" Margin="24">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1D232D" Offset="0"/><GradientStop Color="#0B0E13" Offset="1"/></LinearGradientBrush>
                  </Border.Background>
                  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="50" ShadowDepth="14" Opacity="0.6"/></Border.Effect>
                  <Border BorderBrush="#30FFFFFF" BorderThickness="0" Background="#000000" CornerRadius="3">
                    <Image x:Name="ScreenImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                </Border>
              </Viewbox>
              <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Border x:Name="ConnChip" Background="#151B25" BorderBrush="#27303F" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#5E697C" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnText" Text="Szukam ekranu…" FontSize="12.5"/>
                  </StackPanel>
                </Border>
                <Border Background="#151B25" BorderBrush="#27303F" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,8,0" ToolTip="Ile razy na sekundę ekran dostaje zmienione piksele">
                  <TextBlock x:Name="FpsText" Text="0 kl./s" FontSize="12.5" FontFamily="{StaticResource Mono}"/>
                </Border>
                <Border Background="#151B25" BorderBrush="#27303F" BorderThickness="1" CornerRadius="10" Padding="12,7" ToolTip="Wykorzystanie łącza USB ekranu (maks. ok. 157 KB/s)">
                  <TextBlock x:Name="BwText" Text="0 KB/s" FontSize="12.5" FontFamily="{StaticResource Mono}"/>
                </Border>
              </WrapPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="MOTYW" Style="{StaticResource Cap}"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Button x:Name="PrevTheme" Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="Poprzedni"/>
                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeName" Text="Ember" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ThemeDesc" Text="" Style="{StaticResource SubText}" TextAlignment="Center" Margin="0,3,0,0" MaxHeight="50"/>
                      </StackPanel>
                      <Button x:Name="NextTheme" Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="Następny"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="JASNOŚĆ" Style="{StaticResource Cap}"/>
                      <TextBlock x:Name="BrightText" Text="50 %" HorizontalAlignment="Right" Foreground="{StaticResource Sub}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"/>
                      <TextBlock Grid.Column="2" Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="17" Foreground="#FFB347" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="EKRAN" Style="{StaticResource Cap}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}" Margin="0,0,0,12">
                      <StackPanel><TextBlock Text="Obróć o 180°"/><TextBlock Text="Gdy kabel wychodzi z drugiej strony" Style="{StaticResource SubText}" FontSize="11.5"/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="SleepSwitch" Style="{StaticResource Switch}" Margin="0,0,0,12">
                      <StackPanel><TextBlock Text="Gaś razem z monitorami"/><TextBlock Text="Ekranik nie świeci, gdy Windows wygasi monitory" Style="{StaticResource SubText}" FontSize="11.5"/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="BlankSwitch" Style="{StaticResource Switch}">
                      <StackPanel><TextBlock Text="Wygaś teraz"/><TextBlock Text="Podświetlenie wyłączone do odwołania" Style="{StaticResource SubText}" FontSize="11.5"/></StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <TextBlock Text="CZUJNIKI" Style="{StaticResource Cap}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="SensorStatus"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ===== Motywy ===== -->
          <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Gallery" Margin="0,0,0,10"/>
          </ScrollViewer>

          <!-- ===== Edytor ===== -->
          <Grid x:Name="PageEditor" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="318"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12,14">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DODAJ" Style="{StaticResource Cap}" Margin="4,0,0,8"/>
                <WrapPanel x:Name="AddPanel" DockPanel.Dock="Top" Margin="0,0,0,14"/>
                <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                  <TextBlock Text="WARSTWY" Style="{StaticResource Cap}" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LayerUp" Style="{StaticResource IconBtn}" Content="&#xE74A;" Width="28" Height="26" FontSize="11" ToolTip="Wyżej (na wierzch)"/>
                    <Button x:Name="LayerDown" Style="{StaticResource IconBtn}" Content="&#xE74B;" Width="28" Height="26" FontSize="11" ToolTip="Niżej"/>
                    <Button x:Name="LayerDup" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="28" Height="26" FontSize="11" ToolTip="Duplikuj (Ctrl+D)"/>
                    <Button x:Name="LayerDel" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="28" Height="26" FontSize="11" ToolTip="Usuń (Delete)"/>
                  </StackPanel>
                </Grid>
                <ListBox x:Name="Layers" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#C5CCD8"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="8,5" Margin="0,1"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A212C"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#241A10"/><Setter Property="Foreground" Value="#FFB347"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate></Setter.Value></Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18,0">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Border Padding="10" Background="#0B0E13" CornerRadius="14" BorderBrush="#1C2330" BorderThickness="1" Margin="2">
                  <Grid x:Name="CanvasHost" Width="480" Height="320" ClipToBounds="False" Background="#000000" Cursor="Cross" Focusable="True">
                    <Image x:Name="EditImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="Overlay" Width="480" Height="320" IsHitTestVisible="False"/>
                  </Grid>
                </Border>
              </Viewbox>
              <Grid Grid.Row="1" Margin="4,10,4,0">
                <TextBlock x:Name="EditHint" Style="{StaticResource SubText}" FontSize="11.5" VerticalAlignment="Center"
                           Text="Przeciągaj elementy myszą · strzałki przesuwają o 1 px (Shift: 10 px) · Alt wyłącza przyciąganie · Ctrl+Z cofa"/>
                <TextBlock x:Name="CursorPos" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
              </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,14,8,14">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel x:Name="Props"/>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ===== Czujniki ===== -->
          <Grid x:Name="PageSensors" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <TextBox x:Name="SensorSearch" Width="320" HorizontalAlignment="Left" ToolTip="Szukaj czujnika"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ico}" Foreground="{StaticResource Dim}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="296,0,0,0" IsHitTestVisible="False"/>
              <TextBlock Text="Kliknij wiersz, żeby skopiować klucz do schowka. Klucz wpisujesz w polu „Czujnik” w edytorze albo jako {klucz} w tekście."
                         Style="{StaticResource SubText}" Margin="340,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SensorList"/>
            </ScrollViewer>
          </Grid>

          <!-- ===== Ustawienia ===== -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="SettingsPanel" Orientation="Horizontal"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
