<Window x:Class="Ember.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:e="clr-namespace:Ember"
        Title="Ember" Width="1380" Height="880" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B0E13" Foreground="#E8ECF2" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="/Ember;component/fonts/#Inter, Segoe UI" FontSize="13.5">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <!-- Flat on purpose: no blur or drop-shadow effects anywhere, they keep the GPU busy for every preview frame. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0E13"/>
    <SolidColorBrush x:Key="Side" Color="#0E1218"/>
    <SolidColorBrush x:Key="Card" Color="#121821"/>
    <SolidColorBrush x:Key="Panel" Color="#121821"/>
    <SolidColorBrush x:Key="Raised" Color="#18202B"/>
    <SolidColorBrush x:Key="Field" Color="#0D1117"/>
    <SolidColorBrush x:Key="Line" Color="#1C2330"/>
    <SolidColorBrush x:Key="Line2" Color="#2A3445"/>
    <SolidColorBrush x:Key="Text" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="Sub" Color="#8A94A6"/>
    <SolidColorBrush x:Key="Dim" Color="#5E697C"/>
    <SolidColorBrush x:Key="EmberSolid" Color="#FFB347"/>
    <SolidColorBrush x:Key="EmberSoft" Color="#241A10"/>
    <LinearGradientBrush x:Key="Ember" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFC53D" Offset="0"/><GradientStop Color="#FF6A3D" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Ico">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Num">/Ember;component/fonts/#Inter, Segoe UI</FontFamily>
    <CubicEase x:Key="Out" EasingMode="EaseOut"/>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22,20"/>
    </Style>
    <!-- Older name some code still asks for. -->
    <Style x:Key="Glass" TargetType="Border" BasedOn="{StaticResource CardBox}"/>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Sub}"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#1A1208"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Border CornerRadius="10" Background="{StaticResource Ember}"/>
          <Border x:Name="hl" CornerRadius="10" Background="#FFFFFF" Opacity="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="g" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="g" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#D5DBE5"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Border x:Name="b" CornerRadius="10" Background="#151B25" BorderBrush="#27303F" BorderThickness="1"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2330"/><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="g" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="g" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource EmberSolid}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFD08A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="{StaticResource Ico}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2330"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Sidebar entry. The highlight behind the checked one is a separate shape that slides (MovePill). -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" Background="Transparent" CornerRadius="11" Height="44" Padding="12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Ico}" FontSize="16" Width="20" VerticalAlignment="Center"/>
            <TextBlock Text="{TemplateBinding Content}" Margin="14,0,0,1" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#10FFFFFF"/><Setter Property="Foreground" Value="#D5DBE5"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="ic" Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
            <Border CornerRadius="12" Background="#232C3A"/>
            <Border x:Name="on" CornerRadius="12" Background="{StaticResource Ember}" Opacity="0"/>
            <Ellipse x:Name="knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#8A94A6">
              <Ellipse.RenderTransform><TranslateTransform x:Name="kx"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="knob" Property="Fill" Value="#1A1208"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2" EasingFunction="{StaticResource Out}"/>
              <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Out}"/>
              <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Flag" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#C5CCD8"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="b" CornerRadius="8" Background="#151B25" BorderBrush="#27303F" BorderThickness="1" Padding="11,5"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/><Setter TargetName="b" Property="Background" Value="#241A10"/><Setter Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Margin="2">
          <Border x:Name="b" CornerRadius="8" Background="{StaticResource Ember}" Opacity="0"/>
          <ContentPresenter Margin="12,5" HorizontalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Foreground" Value="#1A1208"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Background="#151B25" BorderBrush="#1F2733" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,5,5">
          <ContentPresenter HorizontalAlignment="Left"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C1A16"/><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="22" Background="Transparent">
          <Border Height="4" CornerRadius="2" Background="#232C3A" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource Ember}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="ts"/></Grid.RenderTransform>
                    <Ellipse Fill="#F4F6FA" Stroke="#FF8A3D" StrokeThickness="3"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.12"/>
                      </Storyboard></BeginStoryboard></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="ts" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                      </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="#FFB347"/><Setter Property="SelectionBrush" Value="#FF9A3D"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="#232C3A" BorderThickness="1" CornerRadius="10">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#D5DBE5"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#1F2733"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFB347"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="MaxDropDownHeight" Value="380"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="tb" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="#232C3A" BorderThickness="1" CornerRadius="10">
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4658"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF9A3D"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,32,7" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#151B25" BorderBrush="#2C3646" BorderThickness="1" CornerRadius="12" Padding="0,5" Margin="0,6,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#2A3445" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#2A3445" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="#1A212D" BorderBrush="#2C3646" BorderThickness="1" CornerRadius="8" Padding="10,6"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
    <Border.RenderTransform><ScaleTransform ScaleX="0.985" ScaleY="0.985"/></Border.RenderTransform>
    <Border.Background>
      <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.55" RadiusY="0.75">
        <GradientStop Color="#22170D" Offset="0"/><GradientStop Color="#0B0E13" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <!-- Collapses to an icon rail (SetSidebar): the width shrinks and the labels are simply clipped away. -->
      <Border x:Name="SideBar" Width="256" ClipToBounds="True" Background="{StaticResource Side}" BorderBrush="#161C25" BorderThickness="0,0,1,0">
        <Grid Margin="16,22,16,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
            <Image x:Name="Logo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Ember" FontSize="17" FontWeight="Bold"/>
              <TextBlock Text="Turing Smart Screen" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,1,0,0"/>
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,34,0,0">
            <Border x:Name="NavPill" VerticalAlignment="Top" Height="44" CornerRadius="11" Background="#241A10" BorderBrush="#4A3214" BorderThickness="1" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform x:Name="NavPillY"/></Border.RenderTransform>
              <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Margin="-1,0,0,0" Background="{StaticResource Ember}"/>
            </Border>
            <StackPanel x:Name="NavPanel">
              <RadioButton x:Name="NavScreen" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="{e:Tr Screen}" IsChecked="True" GroupName="nav"/>
              <RadioButton x:Name="NavThemes" Style="{StaticResource Nav}" Tag="&#xE790;" Content="{e:Tr Themes}" GroupName="nav"/>
              <RadioButton x:Name="NavEditor" Style="{StaticResource Nav}" Tag="&#xE70F;" Content="{e:Tr Editor}" GroupName="nav"/>
              <RadioButton x:Name="NavSensors" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="{e:Tr Sensors}" GroupName="nav"/>
              <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{e:Tr Settings}" GroupName="nav"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2">
            <!-- What the panel is showing right now. -->
            <Border x:Name="MiniCard" Style="{StaticResource CardBox}" Padding="10" CornerRadius="14" Cursor="Hand">
              <StackPanel>
                <Border CornerRadius="8" Background="#000000" Height="132">
                  <Border.Clip><RectangleGeometry Rect="0,0,202,132" RadiusX="8" RadiusY="8"/></Border.Clip>
                  <Image x:Name="MiniScreen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Grid Margin="4,10,4,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="MiniName" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                      <TextBlock x:Name="MiniStatus" FontSize="11.5" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MiniPrev" Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="28" Height="28" FontSize="10"/>
                    <Button x:Name="MiniNext" Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="28" Height="28" FontSize="10"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Button x:Name="CreditBtn" Cursor="Hand" Margin="0,10,0,0" Foreground="{StaticResource Text}">
              <Button.Template><ControlTemplate TargetType="Button">
                <Border x:Name="b" CornerRadius="12" Background="Transparent" Padding="8,8"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#10FFFFFF"/></Trigger></ControlTemplate.Triggers>
              </ControlTemplate></Button.Template>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="32" Height="32">
                  <Ellipse Fill="{StaticResource Ember}"/>
                  <TextBlock Text="C" FontWeight="Bold" FontSize="14" Foreground="#1A1208" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="CreditLine" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                  <TextBlock Text="cybvlsky" FontSize="13.5" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="CreditIcon" Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource Ico}" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="SideToggle" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Margin="5,6,0,0" FontSize="13"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== main ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
          <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{e:Tr 'Close the window. Ember keeps running in the tray.'}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,22">
          <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
          <StackPanel x:Name="TopActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="Pages" Grid.Row="2" Margin="40,0,40,30">

          <!-- ===== Screen ===== -->
          <Grid x:Name="PageScreen">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
            <!-- Device and its status tiles stay together; the column is wider than tall in practice, so width decides the size. -->
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Top">
              <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="980">
                <Border x:Name="Device" Width="540" Height="380" CornerRadius="22" Padding="30" Background="#06080B" BorderBrush="#1E2633" BorderThickness="1.5">
                  <Border Background="#000000" CornerRadius="3">
                    <Image x:Name="ScreenImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="Linear"/>
                  </Border>
                </Border>
              </Viewbox>
              <UniformGrid Columns="3" Margin="0,16,0,0">
                <Border Style="{StaticResource CardBox}" Padding="18,14" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="{e:Tr Connection}" Style="{StaticResource Head}"/>
                    <TextBlock x:Name="ConnText" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}" Padding="18,14" Margin="4,0,4,0" ToolTip="{e:Tr 'Updates per second that reach the panel'}">
                  <StackPanel>
                    <TextBlock Text="{e:Tr 'Frame rate'}" Style="{StaticResource Head}"/>
                    <TextBlock x:Name="FpsText" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}" Padding="18,14" Margin="8,0,0,0" ToolTip="{e:Tr 'USB link use. The panel takes about 157 KB/s.'}">
                  <StackPanel>
                    <TextBlock Text="{e:Tr 'USB link'}" Style="{StaticResource Head}"/>
                    <TextBlock x:Name="BwText" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{e:Tr Theme}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,-8,-6">
                        <Button x:Name="PrevTheme" Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="{e:Tr Previous}"/>
                        <Button x:Name="NextTheme" Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="{e:Tr Next}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ThemeInfo">
                      <TextBlock x:Name="ThemeName" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                      <TextBlock x:Name="ThemeDesc" Style="{StaticResource SubText}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button x:Name="BrowseThemes" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{e:Tr 'All themes'}"/><TextBlock Text="&#xE76C;" FontFamily="{StaticResource Ico}" FontSize="9" Margin="7,2,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{e:Tr Brightness}" Style="{StaticResource Head}"/>
                      <TextBlock x:Name="BrightText" HorizontalAlignment="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"/>
                      <TextBlock Grid.Column="2" Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="17" Foreground="#FFB347" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                  <StackPanel>
                    <CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}">
                      <StackPanel><TextBlock Text="{e:Tr 'Rotate 180°'}" FontWeight="Medium"/><TextBlock Text="{e:Tr 'For when the cable comes out the other side'}" Style="{StaticResource SubText}" FontSize="12"/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="SleepSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0">
                      <TextBlock Text="{e:Tr 'Sleep with the monitors'}" FontWeight="Medium"/>
                    </CheckBox>
                    <CheckBox x:Name="BlankSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0">
                      <TextBlock Text="{e:Tr 'Turn the screen off'}" FontWeight="Medium"/>
                    </CheckBox>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}">
                  <StackPanel>
                    <TextBlock Text="{e:Tr Sensors}" Style="{StaticResource Head}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="SensorStatus"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ===== Themes ===== -->
          <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Gallery" Margin="0,0,0,10"/>
          </ScrollViewer>

          <!-- ===== Editor ===== -->
          <Grid x:Name="PageEditor" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBox}" Padding="12,16,8,12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{e:Tr Add}" Style="{StaticResource Head}" Margin="6,0,0,10"/>
                <UniformGrid x:Name="AddPanel" DockPanel.Dock="Top" Columns="2" Margin="0,0,0,16"/>
                <Grid DockPanel.Dock="Top" Margin="6,0,0,6">
                  <TextBlock Text="{e:Tr Layers}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LayerUp" Style="{StaticResource IconBtn}" Content="&#xE74A;" Width="28" Height="28" FontSize="11" ToolTip="{e:Tr 'Bring forward'}"/>
                    <Button x:Name="LayerDown" Style="{StaticResource IconBtn}" Content="&#xE74B;" Width="28" Height="28" FontSize="11" ToolTip="{e:Tr 'Send backward'}"/>
                    <Button x:Name="LayerDup" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="28" Height="28" FontSize="11" ToolTip="{e:Tr 'Duplicate (Ctrl+D)'}"/>
                    <Button x:Name="LayerDel" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="28" Height="28" FontSize="11" ToolTip="{e:Tr 'Delete (Del)'}"/>
                  </StackPanel>
                </Grid>
                <ListBox x:Name="Layers" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#C5CCD8"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="9,6" Margin="0,1"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A212C"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#241A10"/><Setter Property="Foreground" Value="#FFB347"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate></Setter.Value></Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="4,0">
                <TextBlock x:Name="EditorName" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="EditorState" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="12,0,0,2" VerticalAlignment="Bottom"/>
              </StackPanel>
              <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,14,0,12">
                <Border Padding="12" Background="#06080B" CornerRadius="16" BorderBrush="#1E2633" BorderThickness="1.5" Margin="2">
                  <Grid x:Name="CanvasHost" Width="480" Height="320" ClipToBounds="False" Background="#000000" Cursor="Cross" Focusable="True">
                    <Image x:Name="EditImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="Overlay" Width="480" Height="320" IsHitTestVisible="False"/>
                  </Grid>
                </Border>
              </Viewbox>
              <Grid Grid.Row="2" Margin="4,0">
                <TextBlock x:Name="EditHint" Style="{StaticResource SubText}" FontSize="12" VerticalAlignment="Center"
                           Text="{e:Tr 'Drag to move. Arrows nudge 1 px, Shift+arrows 10 px. Hold Alt to stop snapping.'}"/>
                <TextBlock x:Name="CursorPos" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="20,18,8,18">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel x:Name="Props"/>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ===== Sensors ===== -->
          <Grid x:Name="PageSensors" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid Width="320" HorizontalAlignment="Left">
                <TextBox x:Name="SensorSearch" Padding="34,8,10,8"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ico}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="{e:Tr Search}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="35,0,0,0" IsHitTestVisible="False"/>
              </Grid>
              <TextBlock Text="{e:Tr 'Click a row to copy its key.'}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SensorList" Margin="0,0,8,8"/>
            </ScrollViewer>
          </Grid>

          <!-- ===== Settings ===== -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,8,8"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
