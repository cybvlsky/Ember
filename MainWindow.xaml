<Window x:Class="Ember.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:e="clr-namespace:Ember"
        Title="Ember" Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#202020" Foreground="#FFFFFF" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <!-- Windows 11 dark: neutral layers, one accent used the way Windows uses the system accent. No effects. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#202020"/>
    <SolidColorBrush x:Key="Layer" Color="#272727"/>
    <SolidColorBrush x:Key="Card" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Panel" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardHover" Color="#323232"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Raised" Color="#383838"/>
    <SolidColorBrush x:Key="Field" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Line" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Line2" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sub" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Ember" Color="#FFA066"/>
    <SolidColorBrush x:Key="EmberSolid" Color="#FFB88A"/>
    <SolidColorBrush x:Key="EmberSoft" Color="#3A2E27"/>
    <FontFamily x:Key="Ico">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Num">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CubicEase x:Key="Out" EasingMode="EaseOut"/>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="Glass" TargetType="Border" BasedOn="{StaticResource CardBox}"/>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="16"/>
    </Style>

    <!-- Buttons: 32 px, 4 px corners, a lighter top edge like WinUI's control stroke. -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,5,12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="4" Background="#373737" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#454545" Offset="0"/><GradientStop Color="#303030" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3D3D3D"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#323232"/><Setter Property="Foreground" Value="#CFCFCF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="4" Background="#FFA066" BorderBrush="#FFB585" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFAC7A"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#F0935C"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource EmberSolid}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFD3B5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{StaticResource Ico}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Navigation pane item: 36 px, the moving highlight and accent pill are drawn behind (MovePill). -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" Background="Transparent" CornerRadius="4" Height="36" Padding="12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Ico}" FontSize="16" Width="16" VerticalAlignment="Center"/>
            <TextBlock Text="{TemplateBinding Content}" Margin="16,0,0,1" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0BFFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Toggle switch, WinUI proportions: 40 x 20, the knob slides and grows a little. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
            <Border x:Name="off" CornerRadius="10" Background="#1F1F1F" BorderBrush="#CFCFCF" BorderThickness="1"/>
            <Border x:Name="on" CornerRadius="10" Background="{StaticResource Ember}" Opacity="0"/>
            <Ellipse x:Name="knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="#CFCFCF">
              <Ellipse.RenderTransform><TranslateTransform x:Name="kx"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="knob" Property="Fill" Value="#000000"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16" EasingFunction="{StaticResource Out}"/>
              <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Out}"/>
              <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="Width" Value="14"/><Setter TargetName="knob" Property="Height" Value="14"/><Setter TargetName="knob" Property="Margin" Value="3,0,0,0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Flag" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="b" CornerRadius="4" Background="#373737" BorderBrush="#454545" BorderThickness="1" Padding="10,4,10,5"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3D3D3D"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#FFA066"/><Setter TargetName="b" Property="BorderBrush" Value="#FFA066"/><Setter Property="Foreground" Value="#000000"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="3" Background="Transparent" Padding="12,4,12,5" Margin="2"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#FFA066"/><Setter Property="Foreground" Value="#000000"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="4" Background="#373737" BorderBrush="#424242" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,4,4">
          <ContentPresenter HorizontalAlignment="Left"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3D3D3D"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#323232"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Slider: thin track, the WinUI thumb (dark ring with an accent core that grows on hover). -->
    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="24" Background="Transparent">
          <Border Height="4" CornerRadius="2" Background="#8A8A8A" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource Ember}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Width="20" Height="20">
                    <Ellipse Fill="#454545" Stroke="#505050" StrokeThickness="1"/>
                    <Ellipse x:Name="core" Width="12" Height="12" Fill="{StaticResource Ember}"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="core" Property="Width" Value="14"/><Setter TargetName="core" Property="Height" Value="14"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="core" Property="Width" Value="10"/><Setter TargetName="core" Property="Height" Value="10"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Text box: the bottom edge turns into a 2 px accent line when focused. -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#FFA066"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,5,10,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="b" Background="#2E2E2E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4"/>
          <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Margin="1,0" Background="#8A8A8A" CornerRadius="0,0,4,4"/>
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#323232"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="#1F1F1F"/><Setter TargetName="line" Property="Height" Value="2"/><Setter TargetName="line" Property="Background" Value="#FFA066"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="11,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Grid Margin="5,2">
          <Border x:Name="b" CornerRadius="4" Background="Transparent"/>
          <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Ember}" Visibility="Collapsed"/>
          <ContentPresenter Margin="{TemplateBinding Padding}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/><Setter TargetName="pill" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="MaxDropDownHeight" Value="380"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="tb" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="#373737" BorderBrush="#454545" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3D3D3D"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,5,34,6" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#2C2C2C" BorderBrush="#141414" BorderThickness="1" CornerRadius="8" Padding="0,3" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#7A7A7A" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/><Setter Property="MinHeight" Value="6"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#7A7A7A" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="#2C2C2C" BorderBrush="#141414" BorderThickness="1" CornerRadius="4" Padding="8,5,8,6"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource Bg}" Opacity="0" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- title bar -->
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
        <Button x:Name="SideToggle" Style="{StaticResource IconBtn}" Width="40" Height="36" Content="&#xE700;" FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Image x:Name="Logo" Width="16" Height="16" Margin="12,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Ember" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{e:Tr 'Close the window. Ember keeps running in the tray.'}"/>
      </StackPanel>

      <!-- navigation pane; folds to a 48 px rail (SetSidebar), the labels are clipped away -->
      <Grid x:Name="SideBar" Grid.Row="1" Width="280" ClipToBounds="True">
        <Grid Margin="4,4,4,8">
          <Border x:Name="NavPill" VerticalAlignment="Top" Height="36" CornerRadius="4" Background="#0FFFFFFF" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="NavPillY"/></Border.RenderTransform>
            <Border Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Ember}"/>
          </Border>
          <DockPanel x:Name="NavPanel" LastChildFill="False">
            <RadioButton x:Name="NavScreen" DockPanel.Dock="Top" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="{e:Tr Screen}" IsChecked="True" GroupName="nav"/>
            <RadioButton x:Name="NavThemes" DockPanel.Dock="Top" Style="{StaticResource Nav}" Tag="&#xE790;" Content="{e:Tr Themes}" GroupName="nav"/>
            <RadioButton x:Name="NavEditor" DockPanel.Dock="Top" Style="{StaticResource Nav}" Tag="&#xE70F;" Content="{e:Tr Editor}" GroupName="nav"/>
            <RadioButton x:Name="NavSensors" DockPanel.Dock="Top" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="{e:Tr Sensors}" GroupName="nav"/>
            <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{e:Tr Settings}" GroupName="nav" Margin="0"/>
          </DockPanel>
        </Grid>
      </Grid>

      <!-- content layer, rounded where it meets the pane like WinUI's NavigationView -->
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Layer}" BorderBrush="#1A1A1A" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="36,28,36,20">
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel x:Name="TopActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid x:Name="Pages" Grid.Row="1" Margin="36,0,36,28">

            <!-- ===== Screen ===== -->
            <Grid x:Name="PageScreen">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0" VerticalAlignment="Top">
                <Border Style="{StaticResource CardBox}" Padding="20">
                  <StackPanel>
                    <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="900">
                      <Border x:Name="Device" Width="496" Height="336" Padding="8" Background="#0C0C0C" CornerRadius="6">
                        <Image x:Name="ScreenImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="Linear"/>
                      </Border>
                    </Viewbox>
                    <Grid Margin="2,14,2,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <TextBlock x:Name="ConnText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock x:Name="FpsText" Grid.Column="1" Foreground="{StaticResource Sub}" Margin="24,0,0,0" VerticalAlignment="Center" ToolTip="{e:Tr 'Updates per second that reach the panel'}"/>
                      <TextBlock x:Name="BwText" Grid.Column="2" Foreground="{StaticResource Sub}" Margin="24,0,0,0" VerticalAlignment="Center" ToolTip="{e:Tr 'USB link use. The panel takes about 157 KB/s.'}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="{e:Tr Theme}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,-6,-6">
                          <Button x:Name="PrevTheme" Style="{StaticResource IconBtn}" Content="&#xE76B;" FontSize="12" ToolTip="{e:Tr Previous}"/>
                          <Button x:Name="NextTheme" Style="{StaticResource IconBtn}" Content="&#xE76C;" FontSize="12" ToolTip="{e:Tr Next}"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel x:Name="ThemeInfo">
                        <TextBlock x:Name="ThemeName" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ThemeDesc" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <Button x:Name="BrowseThemes" Style="{StaticResource Link}" Content="{e:Tr 'All themes'}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                    <StackPanel>
                      <Grid>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                          <TextBlock Text="{e:Tr Brightness}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="BrightText" HorizontalAlignment="Right" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                      </Grid>
                      <Slider x:Name="BrightSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Margin="0,10,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                    <CheckBox x:Name="FlipSwitch" Style="{StaticResource Switch}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource Ico}" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel><TextBlock Text="{e:Tr 'Rotate 180°'}"/><TextBlock Text="{e:Tr 'For when the cable comes out the other side'}" Style="{StaticResource SubText}"/></StackPanel>
                      </StackPanel>
                    </CheckBox>
                  </Border>
                  <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                    <CheckBox x:Name="SleepSwitch" Style="{StaticResource Switch}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource Ico}" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="{e:Tr 'Sleep with the monitors'}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </CheckBox>
                  </Border>
                  <Border Style="{StaticResource CardBox}" Margin="0,0,0,16">
                    <CheckBox x:Name="BlankSwitch" Style="{StaticResource Switch}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Ico}" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="{e:Tr 'Turn the screen off'}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </CheckBox>
                  </Border>

                  <TextBlock Text="{e:Tr Sensors}" Style="{StaticResource Head}" Margin="2,0,0,8"/>
                  <Border Style="{StaticResource CardBox}">
                    <StackPanel x:Name="SensorStatus"/>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- ===== Themes ===== -->
            <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="Gallery" Margin="0,0,0,10"/>
            </ScrollViewer>

            <!-- ===== Editor ===== -->
            <Grid x:Name="PageEditor" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardBox}" Padding="10,14,6,10">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{e:Tr Add}" Style="{StaticResource Head}" Margin="6,0,0,10"/>
                  <UniformGrid x:Name="AddPanel" DockPanel.Dock="Top" Columns="2" Margin="0,0,0,14"/>
                  <Grid DockPanel.Dock="Top" Margin="6,0,0,6">
                    <TextBlock Text="{e:Tr Layers}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="LayerUp" Style="{StaticResource IconBtn}" Content="&#xE74A;" Width="28" Height="28" FontSize="12" ToolTip="{e:Tr 'Bring forward'}"/>
                      <Button x:Name="LayerDown" Style="{StaticResource IconBtn}" Content="&#xE74B;" Width="28" Height="28" FontSize="12" ToolTip="{e:Tr 'Send backward'}"/>
                      <Button x:Name="LayerDup" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="28" Height="28" FontSize="12" ToolTip="{e:Tr 'Duplicate (Ctrl+D)'}"/>
                      <Button x:Name="LayerDel" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="28" Height="28" FontSize="12" ToolTip="{e:Tr 'Delete (Del)'}"/>
                    </StackPanel>
                  </Grid>
                  <ListBox x:Name="Layers" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                          <Grid Margin="0,1">
                            <Border x:Name="b" CornerRadius="4" Background="Transparent"/>
                            <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Ember}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="10,6,8,6"/>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0BFFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/><Setter TargetName="pill" Property="Visibility" Value="Visible"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </DockPanel>
              </Border>

              <Grid Grid.Column="1" Margin="16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="2,0">
                  <TextBlock x:Name="EditorName" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                  <TextBlock x:Name="EditorState" Foreground="{StaticResource Sub}" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,12,0,10">
                  <Border Padding="8" Background="#0C0C0C" CornerRadius="6" Margin="2">
                    <Grid x:Name="CanvasHost" Width="480" Height="320" ClipToBounds="False" Background="#000000" Cursor="Cross" Focusable="True">
                      <Image x:Name="EditImage" Width="480" Height="320" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <Canvas x:Name="Overlay" Width="480" Height="320" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                </Viewbox>
                <Grid Grid.Row="2" Margin="2,0">
                  <TextBlock x:Name="EditHint" Style="{StaticResource SubText}" VerticalAlignment="Center"
                             Text="{e:Tr 'Drag to move. Arrows nudge 1 px, Shift+arrows 10 px. Hold Alt to stop snapping.'}"/>
                  <TextBlock x:Name="CursorPos" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </Grid>
              </Grid>

              <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="16,14,6,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                  <StackPanel x:Name="Props"/>
                </ScrollViewer>
              </Border>
            </Grid>

            <!-- ===== Sensors ===== -->
            <Grid x:Name="PageSensors" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,16">
                <Grid Width="320" HorizontalAlignment="Left">
                  <TextBox x:Name="SensorSearch" Padding="10,5,34,6"/>
                  <TextBlock x:Name="SearchHint" Text="{e:Tr Search}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="11,0,0,1" IsHitTestVisible="False"/>
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ico}" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Text="{e:Tr 'Click a row to copy its key.'}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SensorList" Margin="0,0,8,8"/>
              </ScrollViewer>
            </Grid>

            <!-- ===== Settings ===== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SettingsPanel" MaxWidth="1000" Margin="0,0,8,8"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
