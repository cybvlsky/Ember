{
  "name": "Claude Code",
  "description": "Usage from Claude Code's own logs, priced at API rates.",
  "palette": {
    "card": "#2B2B2B", "text": "#FFFFFF", "sub": "#C5C5C5", "dim": "#8A8A8A", "track": "#3D3D3D", "a1": "#FFA066"
