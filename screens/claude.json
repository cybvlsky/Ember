    { "type": "text", "name": "Today cost", "x": 258, "y": 127, "w": 200, "text": "Today {claude.today.cost:usd}", "size": 13, "color": "sub" },

    { "type": "text", "name": "Limit", "x": 22, "y": 182, "text": "Session limit", "size": 12, "weight": 600, "color": "sub" },
    { "type": "text", "name": "Limit value", "x": 458, "y": 182, "align": "right", "text": "{claude.block.pct:0}%", "size": 12, "weight": 600 },
    { "type": "bar", "name": "Limit bar", "x": 22, "y": 202, "w": 436, "h": 6, "radius": 3, "sensor": "claude.block.pct", "color": "a1", "track": "track", "warn": 75, "crit": 90 },
    { "type": "text", "name": "Limit note", "x": 22, "y": 218, "w": 436, "text": "{claude.limit}", "size": 11, "color": "dim" },

    { "type": "text", "name": "Tokens label", "x": 22, "y": 250, "text": "Tokens today", "size": 11, "color": "dim" },
