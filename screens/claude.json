    { "type": "text", "name": "Reset", "x": 120, "y": 127, "w": 102, "align": "right", "text": "{claude.resetText}", "size": 13, "color": "sub" },

    { "type": "text", "name": "Month", "x": 258, "y": 20, "text": "This month", "size": 13, "weight": 600, "color": "sub" },
    { "type": "text", "name": "API prices", "x": 458, "y": 21, "align": "right", "text": "at API prices", "size": 11, "color": "dim" },
    { "type": "text", "name": "Month cost", "x": 258, "y": 50, "w": 200, "text": "{claude.month.cost:usd}", "size": 44, "weight": 600 },
