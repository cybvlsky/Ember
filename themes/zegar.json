    { "type": "text", "name": "Data", "x": 240, "y": 226, "align": "center", "text": "{date:d MMMM yyyy}", "size": 12, "color": "sub" },

    { "type": "text", "name": "CPU", "x": 18, "y": 30, "text": "CPU", "size": 10, "weight": 600, "spacing": 2.5, "color": "dim" },
