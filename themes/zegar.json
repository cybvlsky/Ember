    { "type": "text", "name": "CPU obciążenie", "x": 18, "y": 88, "text": "{cpu.load:0}%", "size": 13, "color": "sub" },
    { "type": "bar", "name": "CPU pasek", "x": 18, "y": 108, "w": 56, "h": 3, "sensor": "cpu.load", "colors": ["a1", "a2"] },
    { "type": "text", "name": "RAM", "x": 18, "y": 222, "text": "RAM", "size": 10, "weight": 600, "spacing": 2.5, "color": "dim" },
    { "type": "text", "name": "RAM %", "x": 17, "y": 240, "text": "{ram.load:0}%", "size": 24, "weight": 600 },
    { "type": "text", "name": "RAM GB", "x": 18, "y": 274, "text": "{ram.used:0.0} GB", "size": 11.5, "color": "sub" },

    { "type": "text", "name": "GPU", "x": 462, "y": 30, "align": "right", "text": "GPU", "size": 10, "weight": 600, "spacing": 2.5, "color": "dim" },
    { "type": "text", "name": "GPU temp", "x": 464, "y": 48, "align": "right", "text": "{gpu.temp:0}°", "size": 30, "weight": 600, "sensor": "gpu.temp", "warn": 78, "crit": 86 },
    { "type": "text", "name": "GPU obciążenie", "x": 462, "y": 88, "align": "right", "text": "{gpu.load:0}%", "size": 13, "color": "sub" },
    { "type": "bar", "name": "GPU pasek", "x": 406, "y": 108, "w": 56, "h": 3, "sensor": "gpu.load", "colors": ["a1", "a2"] },
    { "type": "text", "name": "Sieć", "x": 462, "y": 222, "align": "right", "text": "SIEĆ", "size": 10, "weight": 600, "spacing": 2.5, "color": "dim" },
    { "type": "text", "name": "Sieć wartość", "x": 464, "y": 240, "align": "right", "text": "{net.down:ratev}", "size": 24, "weight": 600 },
    { "type": "text", "name": "Sieć jednostka", "x": 462, "y": 274, "align": "right", "text": "{net.down:rateu}", "size": 11.5, "color": "sub" }
