  "font": "Segoe UI Variable Display",
  "bg": "#06080C",
  "palette": {
    "text": "#F2F5FA", "sub": "#8B95A8", "dim": "#4F5A6E", "line": "#1A2030", "track": "#FFFFFF/7",
    "a1": "#7DD3FC", "a2": "#A78BFA", "warn": "#FBBF24", "crit": "#F87171"
