    { "type": "text", "name": "CPU temp", "x": 100, "y": 70, "align": "center", "text": "{cpu.temp:0}°", "size": 46, "weight": 600, "sensor": "cpu.temp", "warn": 82, "crit": 92 },
    { "type": "text", "name": "CPU", "x": 100, "y": 126, "align": "center", "text": "CPU", "size": 11, "weight": 700, "spacing": 3, "color": "a1" },
    { "type": "text", "name": "CPU load", "x": 100, "y": 145, "align": "center", "text": "{cpu.load:0}%", "size": 14, "color": "sub" },
    { "type": "text", "name": "CPU name", "x": 30, "y": 172, "w": 140, "align": "center", "text": "{cpu.name}", "size": 10, "color": "dim" },

    { "type": "gauge", "name": "GPU temp arc", "x": 294, "y": 14, "w": 172, "h": 172, "sensor": "gpu.temp", "min": 20, "max": 100, "thickness": 12, "start": 150, "sweep": 240, "colors": ["a1", "a2", "a3"], "glow": 8, "mode": "dot", "warn": 80, "crit": 88 },
