{
  "name": "Aurora",
  "description": "Teal and violet on frosted glass. Temperatures in the big arcs, load in the inner ring.",
  "font": "Bahnschrift",
  "bg": "#060A14",
  "palette": {
    "card": "#FFFFFF/5", "line": "#FFFFFF/10", "text": "#EEF3FF", "sub": "#93A3C4", "dim": "#5A6B8E",
    "track": "#FFFFFF/7", "a1": "#4FE3D6", "a2": "#7B6CFF", "a3": "#D47CFF", "warn": "#FFC14D", "crit": "#FF5A7A"
  },
  "widgets": [
