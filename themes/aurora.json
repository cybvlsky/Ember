    { "type": "text", "name": "GPU name", "x": 310, "y": 172, "w": 140, "align": "center", "text": "{gpu.name}", "size": 10, "color": "dim" },

    { "type": "text", "name": "Clock", "x": 240, "y": 44, "align": "center", "text": "{time:HH:mm}", "size": 30, "weight": 600 },
