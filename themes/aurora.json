    { "type": "rect", "name": "VRAM glass", "x": 320, "y": 202, "w": 146, "h": 104, "radius": 14, "color": "card", "stroke": "line" },
    { "type": "text", "name": "VRAM label", "x": 334, "y": 216, "text": "VRAM", "size": 8.5, "weight": 600, "spacing": 1.5, "color": "dim" },
    { "type": "text", "name": "VRAM", "x": 334, "y": 234, "text": "{gpu.vram.used:0.0}", "size": 28, "weight": 600 },
    { "type": "text", "name": "VRAM total", "x": 452, "y": 250, "align": "right", "text": "of {gpu.vram.total:0} GB", "size": 10.5, "color": "sub" },
    { "type": "bar", "name": "VRAM bar", "x": 334, "y": 280, "w": 118, "h": 6, "sensor": "gpu.vram", "colors": ["a1", "a2"], "glow": 6 }
