    { "type": "glow", "name": "Aurora pink", "x": 300, "y": -160, "w": 300, "h": 260, "color": "a3/10" },

    { "type": "gauge", "name": "CPU temp arc", "x": 14, "y": 14, "w": 172, "h": 172, "sensor": "cpu.temp", "min": 20, "max": 100, "thickness": 12, "start": 150, "sweep": 240, "colors": ["a1", "a2", "a3"], "glow": 8, "mode": "dot", "warn": 82, "crit": 92 },
